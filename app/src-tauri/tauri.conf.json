{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HAREC Trainer",
  "version": "0.1.0",
  "identifier": "ie.harec.trainer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "HAREC Trainer",
        "width": 1180,
        "height": 860,
        "minWidth": 420,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://harec-trainer.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
